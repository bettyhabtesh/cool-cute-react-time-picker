{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:demo",
  "outputDirectory": "demo-dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/showcase", "destination": "/showcase.html" },
    { "source": "/stats", "destination": "/index.html" },
    { "source": "/analytics", "destination": "/index.html" }
  ]
}
